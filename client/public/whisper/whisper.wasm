// Mock WebAssembly module for development
// Replace this file with actual compiled whisper.wasm
//
// To build the real WASM module:
//
// 1. Install Emscripten:
//    git clone https://github.com/emscripten-core/emsdk.git
//    cd emsdk
//    ./emsdk install latest
//    ./emsdk activate latest
//    source ./emsdk_env.sh
//
// 2. Build Whisper.cpp:
//    git clone https://github.com/ggml-org/whisper.cpp.git
//    cd whisper.cpp
//    mkdir build-em && cd build-em
//    emcmake cmake ..
//    make -j
//
// 3. Copy the built file:
//    cp bin/whisper.wasm /path/to/your/project/public/whisper/
//    cp bin/whisper.js /path/to/your/project/public/whisper/ (if exists)
//
// For testing, this mock file allows the app to load without errors.
