# ===========================================
# CLIENT ENVIRONMENT VARIABLES FOR RAILWAY
# ===========================================
# These need to be set as build-time variables in Railway
# Go to Railway -> Your Service -> Variables -> Add these
#
# IMPORTANT: In Vite, only variables prefixed with VITE_ are exposed to the client
# These are embedded at BUILD TIME, not runtime

# -------------------------------------------
# API Configuration
# -------------------------------------------
# For production on Railway, leave this EMPTY or don't set it
# The client will use relative URLs (same origin as the app)
# Only set this if your API is on a different domain
VITE_API_URL=

# -------------------------------------------
# Supabase (Client-side)
# -------------------------------------------
# Get these from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Use the anon (public) key - this is safe to expose in client code
# It's protected by Row Level Security policies
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
