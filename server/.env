# Development environment - minimal setup for testing model relay
NODE_ENV=development
PORT=3001

# Google Cloud - leave empty for demo mode
GOOGLE_CREDENTIALS_JSON=

# Stripe - leave empty to disable payments
STRIPE_SECRET_KEY=

# Supabase - leave empty to disable
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter - leave empty to disable
OPENROUTER_API_KEY=