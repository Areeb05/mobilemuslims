# ===========================================
# SERVER ENVIRONMENT VARIABLES FOR RAILWAY
# ===========================================
# Copy these to your Railway project's Variables tab
# Replace placeholder values with your actual credentials

# -------------------------------------------
# Server Configuration
# -------------------------------------------
# PORT is automatically set by Railway - no need to set manually
# PORT=3001

# Node environment (set to 'production' in Railway)
NODE_ENV=production

# FRONTEND_URL and CLIENT_URL are OPTIONAL
# Railway automatically provides RAILWAY_PUBLIC_DOMAIN which the server uses as a fallback
# Only set these if you need to override the Railway domain (e.g., custom domain)
# FRONTEND_URL=https://your-custom-domain.com
# CLIENT_URL=https://your-custom-domain.com

# -------------------------------------------
# Google Cloud Speech-to-Text
# -------------------------------------------
# Paste your entire service account JSON as a single line
# Get this from Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# -------------------------------------------
# Stripe (Payment Processing)
# -------------------------------------------
# Get these from Stripe Dashboard -> Developers -> API keys
# Use sk_live_... for production, sk_test_... for testing
STRIPE_SECRET_KEY=sk_live_...

# Webhook secrets - Get from Stripe Dashboard -> Developers -> Webhooks
# Create a webhook endpoint pointing to: https://your-app.up.railway.app/api/donations/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Separate webhook for PainFreeSalah payments
# If not set, falls back to STRIPE_WEBHOOK_SECRET
STRIPE_PFS_WEBHOOK_SECRET=whsec_...

# -------------------------------------------
# Supabase (Database & Auth)
# -------------------------------------------
# Get these from Supabase Dashboard -> Settings -> API
# URL is your project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the service_role key (NOT anon key) for server-side operations
# This key bypasses Row Level Security - keep it secret!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------
# OpenRouter (AI Trainer with Grok)
# -------------------------------------------
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# -------------------------------------------
# Quran API (alquran.cloud)
# -------------------------------------------
# No API key required - these are optional configuration overrides
# Base URL for the Al-Quran Cloud API
QURAN_API_BASE_URL=https://api.alquran.cloud/v1

# Default translation edition for Quran mode
# Options: en.sahih, en.pickthall, en.yusufali, en.asad, en.hilali
QURAN_DEFAULT_EDITION=en.sahih
